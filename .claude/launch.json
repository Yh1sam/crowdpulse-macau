{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "CROWDPULSE_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000",
        ".venv/bin/uvicorn", "backend.app.main:app", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "--port", "3100"],
      "cwd": "dashboard",
      "port": 3100
    }
  ]
}
